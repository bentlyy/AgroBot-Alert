# Wialon API (dejar vacio para usar mock)
API_TOKEN=

# Base de datos (MariaDB/MySQL)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=agro
DB_PASSWORD=cambia_esta_clave
DB_ROOT_PASSWORD=cambia_esta_clave_root
DB_NAME=agro5
DB_CONNECTION_LIMIT=3

# Email (Gmail)
EMAIL_USER=
EMAIL_PASS=

# SendGrid
SENDGRID_API_KEY=

# Frontend URL (para enlaces de recuperacion)
FRONTEND_URL=http://localhost:5173

# Puerto del servidor
PORT=3000

# JWT Secret
JWT_SECRET=cambia_este_secreto

# Mock API (true = usar datos simulados sin conexion a Wialon)
USE_MOCK_API=true

# Twilio (WhatsApp) - opcional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=

# Email alerts (destinatario) - opcional
ALERT_EMAIL_TO=
